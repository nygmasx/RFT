{
  "name": "rft-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/security.test.ts test/app.test.ts test/geolocation.test.ts test/ranking.test.ts test/official-rankings.test.ts test/club-management.test.ts test/polls.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate:avatars": "tsx scripts/migrate-avatars.ts",
    "migrate:competition-results": "tsx scripts/migrate-competition-results.ts",
    "migrate:latest": "tsx scripts/migrate-latest.ts",
    "backfill:geolocation": "tsx scripts/backfill-geolocation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@hono/node-server": "^2.1.0",
    "better-auth": "^1.2.7",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
