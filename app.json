{
  "expo": {
    "name": "RFT",
    "slug": "RFT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon.png",
    "scheme": "rft",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nygmasx.RFT",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nygmasx.rft",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/brand/android-foreground.png",
        "monochromeImage": "./assets/images/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand/android-monochrome.png",
          "color": "#C8362D",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "android": {
            "image": "./assets/images/brand/splash.png",
            "imageWidth": 160
          },
          "ios": {
            "image": "./assets/images/brand/splash.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2ffb9b1-9747-47e5-ace9-dcc8d62c6f32"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a2ffb9b1-9747-47e5-ace9-dcc8d62c6f32"
    }
  }
}
